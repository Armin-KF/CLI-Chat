FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    libboost-all-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy source code
COPY src/ ./src/
COPY CMakeLists.txt ./

# Build the application
RUN cmake -B build -S . && \
    cmake --build build --target chat_client

# Create non-root user
RUN useradd -m -u 1000 chatuser && \
    chown -R chatuser:chatuser /app

USER chatuser

# Start the client
CMD ["./build/chat_client"]